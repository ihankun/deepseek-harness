{
  "name": "@deepseek-ai/dsh-electron-app",
  "description": "The dsh desktop app: an Electron shell running the dsh web server and GUI in a window",
  "version": "0.1.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/electron"
  },
  "type": "module",
  "main": "lib/main.js",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "lib/main.js",
    "lib/types/preload.mjs",
    "assets",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "author": "DeepSeek",
  "scripts": {
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "gen:icons": "node --import tsx/esm scripts/gen-electron-icons.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/cordis-plugin-logger-console": "workspace:^",
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-anonymous-user-id": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-attachment": "workspace:^",
    "@deepseek-ai/dsh-attachment-local": "workspace:^",
    "@deepseek-ai/dsh-authorization": "workspace:^",
    "@deepseek-ai/dsh-bash-local": "workspace:^",
    "@deepseek-ai/dsh-client-store": "workspace:^",
    "@deepseek-ai/dsh-client-ui-electron": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-web": "workspace:^",
    "@deepseek-ai/dsh-code-runtime": "workspace:^",
    "@deepseek-ai/dsh-compaction": "workspace:^",
    "@deepseek-ai/dsh-fs": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-jobs": "workspace:^",
    "@deepseek-ai/dsh-jobs-local": "workspace:^",
    "@deepseek-ai/dsh-output-retention": "workspace:^",
    "@deepseek-ai/dsh-sandbox": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session-persistence": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^",
    "@deepseek-ai/dsh-session-query": "workspace:^",
    "@deepseek-ai/dsh-session-telemetry": "workspace:^",
    "@deepseek-ai/dsh-session-title-llm": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@deepseek-ai/dsh-settings-file": "workspace:^",
    "@deepseek-ai/dsh-shell": "workspace:^",
    "@deepseek-ai/dsh-spill": "workspace:^",
    "@deepseek-ai/dsh-subagent-in-process-driver": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/dsh-util-time": "workspace:^",
    "@deepseek-ai/dsh-util-workspace-path": "workspace:^",
    "@deepseek-ai/dsh-web-search-exa": "workspace:^",
    "@deepseek-ai/dsh-workflow": "workspace:^",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "ai.deepseek.harness",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "ihankun",
      "repo": "deepseek-harness"
    },
    "files": [
      "lib/**/*",
      "assets/**/*",
      "cordis.patch.yml",
      "package.json"
    ],
    "npmRebuild": true,
    "mac": {
      "icon": "assets/icon2.png",
      "artifactName": "DeepSeek.Harness-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon2-win.png",
      "target": [
        "nsis"
      ],
      "artifactName": "DeepSeek.Harness-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "**/node-pty/**",
      "**/*.exe",
      "**/*.dll"
    ]
  }
}
